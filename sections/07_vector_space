\section{Vector Space}

\begin{definition}[Vector Space]
    The vector space $L$ is a set that satisfies the following properties:
    \begin{enumerate}
        \item For $+,$ a binary operation, the $(L, +)$ is an \emph{Abel group}.
        \item $\forall$scaler $\alpha,$ $\alpha(\b{x} + \b{y}) = \alpha \b{x} + \alpha \b{y}.$
        \item $\forall$scaler $\alpha, \beta,$ $(\alpha + \beta)\b{x} = \alpha \b{x} + \beta \b{x}.$
        \item $\alpha \beta \b{x} = \alpha (\beta \b{x})$
        \item $\forall \b{x} \in L, 1 \b{x} = \b{x}$
    \end{enumerate}
\end{definition}

We therefore present some supplements to the vector space. 

\begin{definition}[Definitions Involving Subspace]
    \begin{align*}
        1. &\forall L' \subset L, s.t. \forall \b{x}, \b{y} \in L', \alpha \b{x} + \beta \b{y} \in L'. L' \text{ is the \emph{subspace} of } L. \\
        2. &L \text{ is the \emph{sum} of its subspaces } L_1, L_2, \cdots, L_k \iff \forall \b{x} \in L, \exists \b{x}_1 \in L_1, \b{x}_2 \in L_2, \cdots, \b{x}_k \in L_k, \\ &\b{x} = \b{x}_1 + \b{x}_2 + \cdots + \b{x}_k. \\
        &L = L_1 + L_2 + \cdots + L_k. \\
        3. &L \text{ is the \emph{direct sum} of its subspaces } L_1, L_2, \cdots, L_k \\ 
        &\iff L \text{ is the sum of subspaces } L_1, L_2, \cdots, L_k. \; \b{x}'s \text{ representation in $\b{x}_1 \in L_1, \b{x}_2 \in L_2, \cdots, \b{x}_k \in L_k$ is unique}. \\
        & L = L_1 \oplus L_2 \oplus \cdots \oplus L_k.
    \end{align*}
\end{definition}

\begin{definition}[Dimension of vector space]
    Similar to the $\rk{A}$ in matrices, the $\dim$ is the maximum quantity of linearly independent vectors in vector space $L.$ 
    If $d = \dim L,$ then $\forall \b{x}_1, \b{x}_2, \b{x}_3, \cdots, \b{x}_{d+1}, \exists \alpha_1, \alpha_2, \cdots, \alpha_{d+1}$ such that
    \begin{align*}
        \alpha_1 \b{x}_1 + \alpha_2 \b{x}_2 + \alpha_3 \b{x}_3 + \cdots + \alpha_{d+1} \b{x}_{d+1} &= 0. \\
        \alpha_1 \b{x}_1 + \alpha_2 \b{x}_2 + \cdots + \alpha_{i-1} \b{x}_{i-1} + \alpha_{i+1} \b{x}_{i+1} + \cdots + \alpha_{d+1} \b{x}_{d+1} &= \b{x}_i
    \end{align*}
    for at least one $\alpha_i \neq 0.$ There is one $x_i$ that is composed by other vectors. Furthermore, $\forall n \l d, \b{x}_1, \b{x}_2, \b{x}_3, \cdots, \b{x}_n$ are, in contrast, \emph{linear independent}. 
\end{definition}

\begin{lemma}
    As in corollary 2.24,
    \begin{equation*}
        \dim(\set{A \b{x}: \b{x} \in V}) = \dim(\set{U_{ij}(c) A U^T_{i'j'}(c') \b{x}: \b{x} \in V}).
    \end{equation*}
\end{lemma}
