\subsection{Vector bases and Vector Space Operations}

\begin{definition}[bases]
    $\b{e}_1, \b{e}_2, \cdots, \b{e}_n \in L,$ such that they are linear independent, and $\forall \b{x} \in L, \b{x} = a_1\b{e}_1 + a_2\b{e}_2 + \cdots + a_n\b{e}_n.$
\end{definition}

We are able to immediately derive the following fact that 
\begin{theorem}
    For any group of linear independent vectors $\b{e}_1, \b{e}_2, \cdots, \b{e}_m,$ we can find other $\b{e}_m, \b{e}_{m+1}, \cdots, \b{e}_n$ such that they form a bases of $L.$
\end{theorem}
The result is proved by simply adding linear independent vectors repeatedly, and it can be written in terms of vector spaces $\forall L' \subset L, \exists L'' \subset L, L = L' \oplus L''.$ The next lemma indicates the dimension's restriction on the vector space.

\begin{lemma}
    Any linear combinations $\b{y}_1, \b{y_2}, \cdots, \b{y}_m$ of vectors $\b{x}_1, \b{x}_2, \cdots, \b{x}_n$ such that $m > n$ are linear dependent. 
\end{lemma}
\begin{proof}
Since the $\b{y}_i$ is a linear combination of vectors $\b{x}_1, \b{x}_2, \cdots, \b{x}_n,$ we have
\begin{equation*}
    \begin{cases}
        a_{11}\b{x}_1 + a_{12}\b{x}_2 + \cdots + a_{1n}\b{x}_n = \b{y}_1 \\
        a_{21}\b{x}_1 + a_{22}\b{x}_2 + \cdots + a_{2n}\b{x}_n = \b{y}_2 \\
        \cdots \\
        a_{m1}\b{x}_1 + a_{m2}\b{x}_2 + \cdots + a_{mn}\b{x}_n = \b{y}_m 
    \end{cases}.
\end{equation*}
We have to construct $m$ coefficients $\alpha_1, \alpha_2, \cdots, \alpha_m$ that are not all zero and 
\begin{equation}
    \alpha_1 \b{y}_1 + \alpha_2 \b{y}_2 + \cdots + \alpha_m \b{y}_m = 0.
\end{equation}
If we plug (8) into the linear combinations, we observe
\begin{equation*}
    (a_{11}\alpha_1 + a_{21}\alpha_2 + \cdots + a_{m1}\alpha_m) \b{x}_1 + (a_{12}\alpha_1 + a_{22}\alpha_2 + \cdots + a_{m2}\alpha_m) \b{x}_2 + \cdots + (a_{1n}\alpha_2 + a_{2n}\alpha_2 + \cdots + a_{mn}\alpha_m) \b{x}_n = 0.
\end{equation*}
The result yields that $\alpha$s ensure the validity of the equation (it equals $0$), thus we must have 
\begin{equation*}
    \begin{cases}
        a_{11}\alpha_1 + a_{21}\alpha_2 + \cdots + a_{m1}\alpha_m = 0 \\
        a_{12}\alpha_1 + a_{22}\alpha_2 + \cdots + a_{m2}\alpha_m = 0 \\
        \cdots \\
        a_{1n}\alpha_2 + a_{2n}\alpha_2 + \cdots + a_{mn}\alpha_m = 0
    \end{cases}.
\end{equation*}
We solve $\alpha$s by Theorem 1.2 since there are fewer equations ($m$) than unknown numbers ($n$).
\end{proof}
\begin{corollary}
    If $\b{e}_1, \b{e}_2, \cdots, \b{e}_n \in L$ are bases, then $\dim L = n.$
\end{corollary}
Next, we follow the train of thought that the bases is correlated with dimensions.

\begin{theorem}
    $L_1, L_2$ is a vector space.
    $$\dim(L_1 \oplus L_2) = \dim L_1 + \dim L_2,$$
    $$\dim(L_1 + L_2) = \dim L_1 + \dim L_2 - \dim(L_1 \cap L_2).$$
\end{theorem}
\begin{proof}
    Let $\b{e}_1, \b{e}_2, \cdots, \b{e}_n$ and $\b{f}_1, \b{f}_2, \cdots, \b{f}_m$ denote a bases of $L_1, L_2.$ Then, every vector in $L_1 \oplus L_2$ is $$\b{x}_1 + \b{x}_2 = a_1\b{e}_1 + a_2\b{e}_2 + \cdots + a_n\b{e}_n + a_{n+1}\b{f}_1 + a_{n+2}\b{f}_2 + \cdots + a_{n+m}\b{f}_m,$$ $\b{x}_1 \in L_1, \b{x}_2 \in L_2.$ $\b{x}_1 + \b{x}_2 = 0$ yields the $a_1, a_2, \cdots, a_{n+m} = 0$ since $\b{x}_1, \b{x}_2 = 0,$ which indicates the linear independence of vectors $\b{e}_1, \b{e}_2, \cdots, \b{e}_n$ and $\b{f}_1, \b{f}_2, \cdots, \b{f}_m.$

    The second result can be derived if we set $L_1 \cap L_2 = L_3, L_1 = L_1' \oplus L_3, L_2 = L_2' \oplus L_3.$
\end{proof}

\begin{definition}
Let $V$ be a finite-dimensional vector space over a field $\mathbb{F}$. 

A \emph{flag} in $V$ is a sequence of subspaces $$\b{0} = V_0 \subset V_1 \subset V_2 \subset \cdots \subset V_k \subset V$$ such that each inclusion is strict.

If, in addition, $\dim V_i = i$ for all $i = 0,1,\dots,n$, where $n = \dim V$ and $$\b{0} = V_0 \subset V_1 \subset \cdots \subset V_n = V,$$ then the flag is called a \emph{complete flag}.
\end{definition}

The series of linear spaces is an additive process of new linear independent vectors.
