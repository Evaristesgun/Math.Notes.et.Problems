% mymath.sty - 解析数论笔记自定义宏包
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mymath}[2026/05/10 Custom Math Macros for Analytic Number Theory]

% 1. 核心宏包加载 (使用 \RequirePackage 替代 \usepackage)
\RequirePackage{amsmath, amssymb, amsthm, amsfonts}
\RequirePackage{mathtools}
\RequirePackage{mathrsfs}
\RequirePackage{enumitem}

% 2. 定理环境配置
% 这里使用 section 作为计数器
\newtheorem{theorem}{Theorem}[section]
\newtheorem{definition}[theorem]{Definition}
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{remark}[theorem]{Remark}

% 3. 自定义数学符号宏
% 范数、绝对值、集合
\newcommand{\norm}[1]{\left\lVert #1 \right\rVert}
\newcommand{\abs}[1]{\left\lvert #1 \right\rvert}
\newcommand{\set}[1]{\left\{ #1 \right\}}

% 指数 e(x) = exp(2*pi*i*x)
\newcommand{\e}[1]{\operatorname{e} \! \left( #1 \right)}

% 留数定义
\newcommand{\Res}[1]{\underset{#1}{\operatorname{Res}} \;}

% 这里的 \l 和 \g 被重新定义为更符合数学书写习惯的斜角不等号
\renewcommand{\l}{\leqslant}
\newcommand{\g}{\geqslant}

% 4. 建议增加的额外常用宏 (可选，方便后续扩展)
% \mathbb 系列快捷键
\newcommand{\CC}{\mathbb{C}}
\newcommand{\RR}{\mathbb{R}}
\newcommand{\ZZ}{\mathbb{Z}}
\newcommand{\NN}{\mathbb{N}}
\newcommand{\QQ}{\mathbb{Q}}

\endinput
