% myalgebra.sty - 线性代数与代数笔记自定义宏包

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{myalgebra}[2026/05/10 Custom Algebra Macros]

% 1. 核心包加载
\RequirePackage{amsmath, amssymb, amsthm, amsfonts, bm}
\RequirePackage{tikz-cd} % 用于交换图表
\RequirePackage{mathtools}
\RequirePackage{mathrsfs}
\RequirePackage{enumitem}
\RequirePackage{url, hyperref}

% 2. 定理环境
\newtheorem{theorem}{Theorem}[section] 
\newtheorem{definition}[theorem]{Definition} 
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{remark}[theorem]{Remark}

% 3. 线性代数专用宏
\newcommand{\norm}[1]{\left\lVert #1 \right\rVert}
\newcommand{\abs}[1]{\left\lvert #1 \right\rvert}
\newcommand{\set}[1]{\left\{ #1 \right\}}
\newcommand{\Res}[1]{\underset{#1}{\operatorname{Res}} \;}

% 符号习惯：斜角不等号
\renewcommand{\l}{\leqslant}
\newcommand{\g}{\geqslant}

% 矩阵与向量快捷键
\renewcommand{\b}[1]{\bm{#1}}           % 粗体向量 \b{v}
\newcommand{\dpr}[1]{\left\langle #1 \right\rangle} % 内积 \dpr{u,v}
\newcommand{\img}{\operatorname{Im}}    % 像空间
\newcommand{\rk}[1]{\operatorname{rank}\! \left( #1 \right)} % 秩

% 矩阵环境简化
\newcommand{\mat}[1]{\begin{pmatrix} #1 \end{pmatrix}} % 普通括号矩阵
\newcommand{\Det}[1]{\begin{vmatrix} #1 \end{vmatrix}} % 行列式
\newcommand{\matV}[1]{\begin{Vmatrix} #1 \end{Vmatrix}} % 范数矩阵

\endinput
