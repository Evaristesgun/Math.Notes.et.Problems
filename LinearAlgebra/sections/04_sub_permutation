\subsection{Permutations}

\begin{definition}[even(odd) permutation]
    Defining the function $\varepsilon(\b{J}),$ $\b{J} = (i_1, i_2, \cdots, i_n)$ is a permutation.
    \begin{equation*}
        \varepsilon(\b{J}) :=
        \begin{cases}
            1 &\text{permutation $\b{J}$ is derived by even-numbered transposition from origin} \\
            -1 &\text{permutation $\b{J}$ is derived by odd-numbered transposition from origin} \\
        \end{cases}
    \end{equation*}    
    If $\varepsilon(\b{J}) = 1,$ $\b{J}$ is an even permutation, and vise versa.
\end{definition}

\begin{definition}[symmetric(antisymmetric) functions]
    For a symmetric function $F(\b{a}_1, \b{a}_2, \cdots, \b{a_n}),$
    $$F(\b{a}_1, \cdots, \b{a}_i, \cdots, \b{a}_j, \cdots, \b{a_n}) = F(\b{a}_1, \cdots, \b{a}_j, \cdots, \b{a}_i, \cdots, \b{a_n}).$$
    For an antisymmetric function $F(\b{a}_1, \b{a}_2, \cdots, \b{a_n}),$
    $$F(\b{a}_1, \cdots, \b{a}_i, \cdots, \b{a}_j, \cdots, \b{a_n}) = -F(\b{a}_1, \cdots, \b{a}_j, \cdots, \b{a}_i, \cdots, \b{a_n}).$$
\end{definition}

\begin{theorem}[A definition of determinant]
    The determinant of a $n$th-order matrix is a solitary function $F(\b{a}_1, \b{a}_2, \cdots, \b{a_n})$ of $n$ rows with $n$ elements such that
    \begin{enumerate}
        \item It is a linear function for each row
        \item It is antisymmetric
        \item $F(\b{e}_1, \b{e}_2, \cdots, \b{e_n}) = 1,$ in which $\b{e}_i$ is the row that has $1$ in its $i$th position and $0$ for its other positions.
    \end{enumerate}
\end{theorem}

\begin{theorem}[multilinear function]
    Any multilinear function can be expressed as 
    $$F(\b{a}_1, \b{a}_2, \cdots, \b{a_n}) = \sum_{(i_1, i_2, \cdots, i_n)} \alpha_{i_1, i_2, \cdots, i_n} a_{1i_1} a_{2i_2} a_{3i_3} \cdots a_{ni_n}$$
    in which $\b{a}_i = (a_{i1}, a_{i2}, a_{i3}, \cdots, a_{in}),$ and coefficient $\alpha_{i_1, i_2, \cdots, i_n}$ are only related to their indexes rather than rows.

    The coefficient $\alpha_{i_1, i_2, \cdots, i_n} = F(\b{e}_{i_1}, \b{e}_{i_2}, \cdots, \b{e}_{i_n}).$
\end{theorem}
\textbf{(idea)}
It is easily proven by induction, since any linear function is $F(\b{x}) = \sum_{i = 1}^n a_i x_i.$ In fact, from Theorem 2.11, we acknowledge the explicit formula for determinants. The determinant function $$F(\b{e}_{i_1}, \b{e}_{i_2}, \cdots, \b{e}_{i_n})$$ can be considered a permutation $\b{J}$ of the rows from the original matrix $E.$ Since we know the $I$ process adds $-$ to its determinant, we have $F(\b{e}_{i_1}, \b{e}_{i_2}, \cdots, \b{e}_{i_n}) = \varepsilon(\b{J}) \det E = \varepsilon(\b{J}).$ Thus,

$$\det A = \sum_{\b{J}} \varepsilon(\b{J}) a_{1i_1} a_{2i_2} a_{3i_3} \cdots a_{ni_n}.$$
