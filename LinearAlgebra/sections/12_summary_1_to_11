\section{A Short summary from Gaussian elimination to vector space}

\begin{theorem}[1605, Binet-Cauchy Formula]
    $A \in M^{m \times n}, B \in M^{n \times m}.$ $$C = AB = (c_{ij}), \quad c_{ij} = \sum_{k=1}^{n} a_{ik} b_{kj}, \quad (i,j=1,\dots,m),$$ $A_{i_1,\dots,i_m}$ selects $i$ columns of matrix $A$; $B_{i_1,\dots,i_m}$ extracts $B$'s columns.
    $$\det(C) = \sum_{1 \le i_1 < \cdots < i_m \le n} \det A_{i_1,\dots,i_m} \det B_{i_1,\dots,i_m}.$$ If $m > n,$ $\det C = 0.$
\end{theorem}
\begin{proof}
Denote by $$\mathcal{I} = \set{(i_1,\dots,i_m) : 1 \le i_1 < \cdots < i_m \le n}.$$

\begin{enumerate}
\item \textbf{Leibniz expansion of $\det C$.}

Using Leibniz formula,
\begin{align*}
    \det C &= \sum_{\sigma \in S_m} \varepsilon(\sigma) \prod_{l=1}^m c_{l \sigma(l)} = \sum_{\sigma \in S_m} \varepsilon(\sigma) \prod_{l=1}^m \sum_{k=1}^n a_{l k} b_{k\,\sigma(l)}. \\
    \det C &= \sum_{\sigma \in S_m} \varepsilon(\sigma) \sum_{1 \l k_1,\dots,k_m \l n} \prod_{l=1}^m a_{l k_l} b_{k_l\,\sigma(l)},
\end{align*}
by expanding the product.

\item \textbf{Cancellation of terms with repeated indices.}

If $(k_1,\dots,k_m)$ contains repeated values, say $k_p = k_q$ with $p \neq q$, 
then exchanging $p$ and $q$ does not change the product $$\prod_{l=1}^m a_{l k_l} b_{k_l\,\sigma(l)},$$ but changes the sign of the permutation $\sigma.$ Hence such terms cancel in pairs.

Therefore, only tuples $(k_1,\dots,k_m)$ with all $k_l$ distinct contribute.

\item \textbf{Reindexing by subsets and permutations.}

If $k_1,\dots,k_m$ are all distinct, then they form a subset $I = \{i_1,\dots,i_m\} \in \mathcal{I},$ and there exists a unique permutation $\tau \in S_m$ such that $k_l = i_{\tau(l)}.$ Thus, we may rewrite
\begin{align*}
    &\sum_{k_1,\dots,k_m \text{ distinct}} \cdot \iff \sum_{I \in \mathcal{I}} \sum_{\tau \in S_m} \cdot \\
    &\det C = \sum_{\sigma \in S_m} \varepsilon(\sigma) \sum_{I \in \mathcal{I}} \sum_{\tau \in S_m} \prod_{l=1}^m a_{l\, i_{\tau(l)}} b_{i_{\tau(l)}\, \sigma(l)}.
\end{align*}

Let $\rho := \sigma \circ \tau^{-1}$. Then $\sigma = \rho \circ \tau$, and $\varepsilon(\sigma) = \varepsilon(\rho)\varepsilon(\tau).$ Hence, $$\det C = \sum_{I \in \mathcal{I}} \sum_{\rho \in S_m} \varepsilon(\rho) \left( \sum_{\tau \in S_m} \varepsilon(\tau) \prod_{l=1}^m a_{l\, i_{\tau(l)}} \right) \left( \prod_{k=1}^m b_{i_k\, \rho(k)} \right).$$

\item \textbf{Identification with determinants.}

Observe that
\begin{align*}
    \sum_{\tau \in S_m} \varepsilon(\tau) \prod_{l=1}^m a_{l\, i_{\tau(l)}} &= \det(A_{i_1,\dots,i_m}), \\
    \sum_{\rho \in S_m} \varepsilon(\rho) \prod_{k=1}^m b_{i_k\, \rho(k)} &= \det(B_{i_1,\dots,i_m}).
\end{align*}

Therefore, $$\det C = \sum_{I \in \mathcal{I}} \det(A_{i_1,\dots,i_m}) \det(B_{i_1,\dots,i_m}).$$

\end{enumerate}

If $m > n$, there are no such subsets $I$, hence $\det C = 0$.
\end{proof}
