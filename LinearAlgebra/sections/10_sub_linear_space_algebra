\subsection{Linear Space Algebra}

\begin{definition}[Isomorphism]
    If operator $A: L \to M$ is also a bijection (One-to-one correspondence), then it is an isomorphism. We denote $A: L \xrightarrow{\sim} M,$ and $L \cong M.$ The Isomorphism is an equivalence relation.
\end{definition}

\begin{theorem}
    If linear spaces $L, M$ have limited dimensions, $L \cong M \iff \dim L = \dim M.$
\end{theorem}
\begin{proof}
The necessary condition of the theorem, $\dim L = \dim M \Rightarrow L \cong M,$ can be proved by using the $\mathbb{K}^n := \set{(a_1, a_2, \cdots, a_n): a_1, a_2, \cdots, a_n \in \mathbb{K}}.$ It clear that $L \cong \mathbb{K}^n, M \cong \mathbb{K}^n,$ and $L \cong M.$

The sufficient condition requires that for a basis $\b{e}_1, \b{e}_2, \cdots, \b{e}_n \in L,$ $\b{f}_1, \b{f}_2, \cdots, \b{f}_n = A(\b{e}_n) \in M$ is also a basis when $L \cong M$, which in turn indicates that $\b{f}_1, \b{f}_2, \cdots, \b{f}_n$ are linear independent, and $\forall \b{x} \in M,$ $\b{x}$ is a linear combination of $\b{f}_1, \b{f}_2, \cdots, \b{f}_n.$ Let $A \xrightarrow{\sim} M.$

If $a_1\b{e}_1 + a_2\b{e}_2 + \cdots + a_n\b{e}_n = \b{0},$ then $A(a_1\b{e}_1 + a_2\b{e}_2 + \cdots + a_n\b{e}_n) = A(\b{0}),$ $a_1\b{f}_1 + a_2\b{f}_2 + \cdots + a_n\b{f}_n = \b{0}' \in M,$ but such a scenario only takes place while $a_1, a_2, \cdots, a_n = 0$ since $A(\b{0}) = \b{0}'.$ Thus, $\b{f}_1, \b{f}_2, \cdots, \b{f}_n$ are linear independent.

For any $\b{x} \in M,$ $\exists! \b{y} \in L, A(\b{y}) = \b{x}.$ $\b{y} = a_1\b{e}_1 + a_2\b{e}_2 + \cdots + a_n\b{e}_n,$ so $\b{x} = A(a_1\b{e}_1 + a_2\b{e}_2 + \cdots + a_n\b{e}_n) = a_1\b{f}_1 + a_2\b{f}_2 + \cdots + a_n\b{f}_n.$ Thus, $\forall \b{x} \in M,$ $\b{x}$ is a linear combination of $\b{f}_1, \b{f}_2, \cdots, \b{f}_n.$
\end{proof}

\begin{definition}[Kernel]
    For $A: L \to M,$ $\ker A := \set{\b{x} \in L: A(\b{x}) = \b{0}' \in M}. \ker A \subset L.$
\end{definition}
\begin{definition}[Image]
    For $A: L \to M,$ $\img A := \set{A(\b{x}): \b{x} \in L}. \img A \subset M.$
\end{definition}

It is time to introduce the Rank-Nullity theorem to reveal the correlation between our previous insights, which we have already seen in the Gaussian elimination and Rank chapters.
\begin{theorem}[Rank-Nullity Theorem]
    For any linear transformation such that $T: V \to W, \dim V$ is finite, 
    \begin{equation}
        \dim(\img T) + \dim(\ker T) = \dim V
    \end{equation}
\end{theorem}
The creation of the theorem is inspired by $(3), (4).$ We can easily verify some interesting facts: for $[T(\b{x})]_{\mathcal{E'}} = A [\b{x}]_{\mathcal{E}}, \rk{A} = \dim (\img T);$ $\dim(\ker T)$ is defined as the \emph{nullity} of the mapping $T.$


We are able to provide a draft addressing the validity of the Rank-Nullity Theorem, \emph{in my words}.
\begin{proof}
The linear map $T$ is depicted by a matrix $A$ that transforms the vectors in $V$ to $W,$
\begin{align*}
    &T: V \to W, \; [\b{x}]_{\mathcal{E}} \longmapsto [T]_{\mathcal{E}' \leftarrow \mathcal{E}} [\b{x}]_{\mathcal{E}}, \\
    &A := [T]_{\mathcal{E}' \leftarrow \mathcal{E}},\; \b{b} := A[\b{x}]_{\mathcal{E}}. \\
    &\text{If we choose another basis $\mathcal{F'}, \mathcal{E'},$ then according to Theorem 3.15:} \\
    &A' = [I_M]_{\mathcal{F'} \leftarrow \mathcal{F}} A [I_L]_{\mathcal{E'} \leftarrow \mathcal{E}}^{-1} \Longrightarrow \rk{A'} = \rk{A}, \text{ which implies the inalterableness of rank.} \\
    &\b{x} := (x_1, x_2, \cdots, x_n)^T \in V, \; \b{b} := (b_1, b_2, \cdots, b_m)^T \in \img T \subset W, \; A \in M^{m \times n}.
\end{align*}
We shall provide some insight for the proof of the theorem one step at a time.

\begin{enumerate}
    \item $\dim V = n,$ $n$ represents the dimension of the domain $V$, which is the number of coordinates of the input vector $\b{x}$.
    \item $\dim(\img T) = \rk{A}.$ 
    
    The $\dim(\img T)$ represents the number of vectors in a basis in $\img T = \set{A\b{x}: \b{x} \in \b{V}}.$ We incorporate lemma 1.30 to reduce the matrix $A$ to Row Echelon Form, and we notice that the result vector of $\b{b}$ is solely determined by the $\rk{A}$ main unknown numbers. Thus, $\dim(\img T) = \rk{A}.$
    
    \item $\dim(\ker T) =$ the quantity of free unknown numbers in the linear equations $= n - \rk{A}.$

    The $\ker T \subset V$ is a linear subspace. Observing the Row Echelon Form of $A,$ we realize that for each $\b{x}$ such that $T(\b{x}) = \b{0},$ its pivot unknown numbers (the first $\rk{A}$ unknown numbers) are solely determined by its last $n - \rk{A}$ free unknown numbers according to the linear equations. Thus, its dimension is exactly $n - \rk{A}$ 
\end{enumerate}
Therefore, we obtain $\dim(\img T) + \dim(\ker T) = \rk{A} + n - \rk{A} = n = \dim V.$
\end{proof}

\begin{remark}
    The rank-nullity theorem is actually a linear-algebraic version of \emph{Isomorphism Theorem} A that puts dimension on both sides.
    \begin{equation}
        G/\ker \sigma \cong \img \sigma \Longrightarrow V/\ker T \cong \img T,
    \end{equation}
    for which $$\dim V/\ker T = \dim V - \dim(\ker T).$$
\end{remark}

My proof is based on rather specific calculations on Matrix; however, the theorem can also be proven in pure operator algebra, refining with extra universality. For such proof to be done, we have to develop our knowledge toward isomorphism.

\begin{theorem}[Isomorphic Condition involving Kernel]
    $$\forall A: L \to M,\; \dim L = \dim M,\; \ker A =\set{\b{0}} \Longrightarrow A: L \xrightarrow{\sim} M.$$
\end{theorem}
Just consider the basis $\b{e}_1, \b{e}_2, \cdots, \b{e}_n \in L,$ and $A(\b{e}_1), A(\b{e}_2), \cdots, A(\b{e}_n) \in M.$

\begin{theorem}[Isomorphic Condition involving Image]
    $$\forall A: L \to M,\; \dim L = \dim M,\; \img A = M \Longrightarrow A: L \xrightarrow{\sim} M.$$
\end{theorem}
Consider basis $\b{e}_1, \b{e}_2, \cdots, \b{e}_n \in L$ such that $A(\b{e}_1), A(\b{e}_2), \cdots, A(\b{e}_n) \in M$ forms a basis.

\begin{theorem}[Isomorphic Condition involving Singularity]
    If for every basis $\mathcal E \in L,\; \mathcal F \in M,\; A: L \to M$ has $\det([A]_{\mathcal{F} \leftarrow \mathcal{E}}) \neq 0,$ then $A$ is \emph{nonsingular}.
    $$A: L \xrightarrow{\sim} M,\; \dim L = \dim M \iff A \text{ is nonsingular}.$$
\end{theorem}

\begin{definition}[Rank of an operator]
    For $A: L \to M,$ $\rk{A} := \dim(\img A).$
\end{definition}

Now, we have enough prerequisites to provide a general proof of the Rank-Nullity theorem.
\begin{theorem}[Extended Rank-Nullity Theorem]
    For an operator $A: L \to M,$ $\rk{A} + \dim(\ker A) = \dim L.$ Plus, we are able to select bases $\mathcal E, \mathcal{F}$ in $L, M$ such that $$[A]_{\mathcal{F} \leftarrow \mathcal{E}} = \mat{E_r & 0 \\ 0 & 0}, \; r := \rk{A}.$$
\end{theorem}
\begin{proof}
We decompose $L = \ker A \oplus L_1,$ $M = \img A \oplus M_1.$ Considering the restriction of $A$ on $L_1 \to \img A,$ namely $A': L_1 \to \img A,$ $\forall \b{x} \in L, \b{x} = \b{u} + \b{v},$ $\b{u} \in \ker A, \b{v} \in L_1,$ $A(\b{x}) = A(\b{u}) + A(\b{v}) = \b{0} + A'(\b{v}).$ Noticing that $\ker A' = \set{\b{0}}, \img A' = \img A,$ $$\forall \text{ base } \b{f}_1, \b{f}_2, \cdots, \b{f}_r \in \img A,\; \exists \b{e}_1, \b{e}_2, \cdots, \b{e}_r \in L_1, \b{\b{f}_i} = A'(\b{e}_i), \text{ is also a base} \Longrightarrow A': L_1 \xrightarrow{\sim} \img A.$$ We derived $L_1 \cong \img A,$ and $\dim L = \dim(\ker A) + \dim L_1 = \dim(\ker A) + \dim(\img A).$

We select base $\b{v}_1, \b{v}_2, \cdots, \b{v}_r \in L_1,$ and $\b{u}_1, \b{u}_2, \cdots, \b{u}_{n-r} \in \ker A.$ Combining, we obtain $\b{v}_1, \cdots, \b{v}_r, \b{u}_1, \cdots, \b{u}_{n-r}$ as another base of $L.$ 

Since $A'$ is an isomorphism, $A'(\b{v}_1), A'(\b{v}_2), \cdots, A'(\b{v}_r) \in \img A,$ and we just expand these linear independent vectors to a base in $M.$ Thus, for a base $\mathcal{F} = A'(\b{v}_1), A'(\b{v}_2), \cdots, A'(\b{v}_r), \b{f}_{r+1}, \cdots, \b{f}_m \in M,$ we found a base $\mathcal{E} = \b{v}_1, \b{v}_2, \cdots, \b{v}_r, \b{u}_1, \b{u}_2, \cdots, \b{u}_{n-r} \in L$ such that it satisfied $$[A]_{\mathcal{F} \leftarrow \mathcal{E}} = \mat{E_r & 0 \\ 0 & 0}.$$
\end{proof}
\begin{corollary}
    $\forall A = M^{m \times n}, \exists \text{ nonsingular } B, C$ such that $$BAC^{-1} = \mat{E_r & 0 \\ 0 & 0}$$
\end{corollary}
